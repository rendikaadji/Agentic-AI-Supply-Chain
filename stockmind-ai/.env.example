# StockMind AI — Configuration Environment

# AI Engine Provider:
# - "local" : Deterministic Autonomous ReAct Engine (100% Offline, Zero Cost, Default)
# - "gemini": Google Gemini 1.5 Flash / Pro (Free Tier via Google AI Studio Key)
# - "ollama": Local LLM via Ollama (http://localhost:11434)
AI_PROVIDER=local

# Google Gemini API Key (Opsional jika AI_PROVIDER=gemini)
GEMINI_API_KEY=

# Local Ollama Settings (Opsional jika AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Backend Server Port
API_HOST=127.0.0.1
API_PORT=8000

# Roboflow Universe Dataset (Vision Inventory Agent)
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=instance-segmentation-zza7a
ROBOFLOW_PROJECT=cardboard-box-detection-rjrm9
ROBOFLOW_VERSION=1
